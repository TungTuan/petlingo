# Production template only. Copy outside source control and replace every
# placeholder with values from the deployment platform's secret manager.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/petlingo?schema=public&sslmode=require"
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
JWT_ACCESS_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
JWT_REFRESH_SECRET="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
# Include the web domain plus native Capacitor origins when applicable.
CORS_ORIGIN="https://app.example.com,capacitor://localhost,http://localhost"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_ONE_TIME_PASSWORD"
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
