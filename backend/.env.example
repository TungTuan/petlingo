# Postgres connection string used by Prisma
DATABASE_URL="postgresql://petlingo:petlingo@localhost:5432/petlingo?schema=public"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS - comma separated list of allowed origins for the frontend app
CORS_ORIGIN="http://localhost:5173"

# Used only by `npm run prisma:seed` to create/promote the first admin
# account (role=ADMIN) for /admin. Change the password after first login.
ADMIN_EMAIL="admin@petlingo.dev"
ADMIN_PASSWORD="admin1234"

# Social login (Google/Facebook/Apple) — see src/lib/socialProviders.ts. All
# optional: left blank, the corresponding endpoint just returns a clear
# "chưa cấu hình" error instead of the server crashing at boot.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
