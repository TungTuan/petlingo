# Copy to .env.release and replace with the real production backend.
# `npm run build:release` refuses missing or non-HTTPS URLs.
VITE_API_URL=https://api.example.com

# Optional social-login credentials. Hide unfinished providers in the UI
# before release instead of shipping empty values.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_APPLE_CLIENT_ID=
